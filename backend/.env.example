# Copia este archivo como backend/.env y completa los valores.
# backend/.env NUNCA se sube a GitHub (está en .gitignore).

# Conexión a PostgreSQL local (contenedor aroma-postgres).
# Reemplaza CAMBIAR por la contraseña que usaste al crear el contenedor.
DATABASE_URL=postgresql+psycopg://aroma_user:CAMBIAR@localhost:5432/aroma_inventory

# Secreto para firmar los tokens JWT: mínimo 32 caracteres, distinto en cada computadora.
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR

# Duración de las sesiones
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REMEMBER_REFRESH_TOKEN_DAYS=30
