# =========================================================
# Aroma Cacao - Variables de entorno de ejemplo (.env)
# Copia este archivo a 'backend/.env' y configura tus valores reales.
# =========================================================

# Conexión a la base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/aroma_cacao

# Clave secreta para firma de tokens JWT (HS256). Mínimo 32 caracteres.
# Generar una segura (ejemplo: openssl rand -hex 32)
JWT_SECRET=reemplaza_este_valor_con_una_clave_secreta_de_al_menos_32_caracteres

# Duración del access token en minutos (por defecto: 15)
ACCESS_TOKEN_MINUTES=15

# Duración del refresh token estándar en días (por defecto: 7)
REFRESH_TOKEN_DAYS=7

# Duración del refresh token extendido (remember_me) en días (por defecto: 30)
REMEMBER_REFRESH_TOKEN_DAYS=30
